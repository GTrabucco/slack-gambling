diff --git a/client/src/theme.js b/client/src/theme.js
new file mode 100644
index 0000000..9ca3363
--- /dev/null
+++ b/client/src/theme.js
@@ -0,0 +1,45 @@
+import { createTheme } from '@mui/material';
+
+// Shared color tokens. Use these (or the matching theme palette entries /
+// CSS variables in index.css) instead of hardcoding hex values in components.
+export const colors = {
+  primary: '#90caf9',
+  gold: '#D4AF37',
+  goldBright: '#FFD700',
+  donate: '#e91e63',
+  donateHover: '#ad1457',
+  rules: '#ef5350',
+  rulesHover: '#c62828',
+  lineMoved: '#ffb74d',
+};
+
+// Result colors for a pick: 1 = win, -1 = loss, 0 = push.
+export const resultColors = {
+  win: { bg: 'rgba(27,94,32,0.35)', text: '#a5d6a7' },
+  loss: { bg: 'rgba(127,0,0,0.35)', text: '#ef9a9a' },
+  push: { bg: 'rgba(74,56,0,0.35)', text: '#ffe082' },
+};
+
+export const getResultColor = (result) => {
+  if (result === 1) return resultColors.win;
+  if (result === -1) return resultColors.loss;
+  if (result === 0) return resultColors.push;
+  return null;
+};
+
+const theme = createTheme({
+  palette: {
+    mode: 'dark',
+    primary: { main: colors.primary },
+    gold: { main: colors.gold, light: colors.goldBright, contrastText: '#3d2b00' },
+    background: {
+      default: '#121212',
+      paper: '#1e1e1e',
+    },
+  },
+  typography: {
+    fontFamily: "'Inter', sans-serif",
+  },
+});
+
+export default theme;
diff --git a/client/src/utils/pickChanges.js b/client/src/utils/pickChanges.js
new file mode 100644
index 0000000..ee0f933
--- /dev/null
+++ b/client/src/utils/pickChanges.js
@@ -0,0 +1,15 @@
+// Diff the user's locally staged picks (tempPicks) against what is saved on
+// the server (selectedPicks). Picks are keyed by type — one per type per week.
+export const getPickChanges = (selectedPicks = [], tempPicks = []) => {
+    const additions = tempPicks.filter(tempPick => {
+        const existing = selectedPicks.find(p => p.type === tempPick.type);
+        if (!existing) return true;
+        return existing.gameId !== tempPick.gameId || existing.text !== tempPick.text;
+    });
+    const removals = selectedPicks.filter(existing =>
+        !tempPicks.find(p => p.type === existing.type)
+    );
+    return { additions, removals, count: additions.length + removals.length };
+};
+
+export const PICK_TYPES = ["favorite", "dog", "over", "under", "gotw"];
